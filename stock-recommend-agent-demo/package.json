{
  "name": "stock-recommend-agent-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI stock recommendation agent demo with explainable scoring and a web UI.",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "node server/index.mjs",
    "dev:server:watch": "node --watch-path=server --watch server/index.mjs",
    "dev:web": "vite --host 0.0.0.0",
    "start": "node server/index.mjs",
    "test": "node --test",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@langchain/core": "^1.1.48",
    "@langchain/langgraph": "^1.3.0",
    "@langchain/openai": "^1.4.1",
    "@langchain/quickjs": "^0.4.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "dedent": "^1.7.2",
    "deepagents": "^1.10.2",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "langchain": "^1.4.4",
    "marked": "^18.0.5",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "undici": "^7.27.2",
    "vite": "^7.2.7",
    "yahoo-finance2": "^2.14.0",
    "zod": "^4.3.6"
  }
}
